# ==============================================================================
# 🇰🇭 KHMER HELP KHMER - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Database Configuration (SQLite native engine with WAL mode)
DATABASE_PATH=./data/khmer_help_khmer.db

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Set to 'true' in production with public HTTPS URL, 'false' for local polling
TELEGRAM_USE_WEBHOOK=false
# Secret token verified in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=generate_a_random_32_character_secret_here

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeInProduction2026!
ADMIN_SESSION_SECRET=generate_a_random_64_character_session_secret_here

# Payment Gateway Configuration
# Mode: 'test' for simulated payment testing without real money, 'production' for live payments
PAYMENT_MODE=test
# Active Provider: 'test', 'bakong_khqr', or 'stripe'
PAYMENT_PROVIDER=test
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Cambodian Bakong KHQR Configuration (National Bank of Cambodia standard)
BAKONG_MERCHANT_ID=khmer_help_khmer@aba
BAKONG_ACQUIRING_BANK=ABA Bank
BAKONG_MERCHANT_NAME=Khmer Help Khmer Charity
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD

# Stripe / International Gateway (Optional)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Security & Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MIN_DONATION_AMOUNT=0.10

# Support & Contact Information
ADMIN_CONTACT_USERNAME=@KhmerHelpKhmerSupport
SUPPORT_PHONE=+855 12 345 678
SUPPORT_EMAIL=support@khmerhelpkhmer.org
